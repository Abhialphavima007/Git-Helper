# Copy to .env and set a random secret. The Azure DevOps PAT is entered in the
# UI at runtime and stored only in the server-side session, never here.
PORT=4000
# Required on hosted deployments (Vercel) — the server refuses to start a
# session without it. Locally it's optional: a random per-machine secret is
# generated in ~/.azdo-git-helper/session.key when this is unset.
SESSION_SECRET=change-me-to-a-long-random-string
# Off hosted deployments the API only answers requests addressed to localhost.
# List extra host names here (comma-separated) if you reach it another way,
# e.g. ALLOWED_HOSTS=192.168.1.20,devbox.local
# ALLOWED_HOSTS=
