{
  "name": "azdo-git-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Friendly visual layer over Azure DevOps Repos. Single Vite + React + Tailwind app with the PAT-holding proxy mounted as Vite middleware.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:api": "node scripts/build-api.mjs",
    "build:vercel": "vite build && node scripts/build-api.mjs",
    "desktop:build": "vite build --outDir desktop/dist --emptyOutDir && node scripts/build-desktop.mjs",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run desktop:build && node tests/run.cjs",
    "test:quick": "node tests/run.cjs",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp:install": "node scripts/build-mcp.mjs && node scripts/install-mcp.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-query": "^5.105.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
